{
  "name": "ark-code",
  "version": "0.0.0",
  "private": true,
  "description": "Ark Code IDE application based on Eclipse Theia.",
  "main": "lib/backend/electron-main.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:app-bar && npm run rebuild && theia build --mode development",
    "build:app-bar": "npm run build --workspace @arkcode/app-bar",
    "rebuild": "theia rebuild:electron",
    "start": "theia start",
    "clean": "theia clean"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Ark Code"
      }
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "@theia/ffmpeg": true,
    "@vscode/windows-ca-certs": true,
    "core-js": false,
    "cpu-features": true,
    "drivelist": true,
    "esbuild": true,
    "fsevents": true,
    "keytar": true,
    "msgpackr-extract": true,
    "native-keymap": true,
    "node-pty": true,
    "protobufjs": false,
    "puppeteer": true,
    "ssh2": true
  },
  "dependencies": {
    "@arkcode/app-bar": "0.0.0",
    "@theia/bulk-edit": "1.74.0",
    "@theia/callhierarchy": "1.74.0",
    "@theia/console": "1.74.0",
    "@theia/core": "1.74.0",
    "@theia/debug": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/editor-preview": "1.74.0",
    "@theia/electron": "1.74.0",
    "@theia/external-terminal": "1.74.0",
    "@theia/file-search": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/getting-started": "1.74.0",
    "@theia/keymaps": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/memory-inspector": "1.74.0",
    "@theia/messages": "1.74.0",
    "@theia/metrics": "1.74.0",
    "@theia/mini-browser": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/outline-view": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/plugin-dev": "1.74.0",
    "@theia/plugin-ext": "1.74.0",
    "@theia/plugin-ext-headless": "1.74.0",
    "@theia/plugin-ext-vscode": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/property-view": "1.74.0",
    "@theia/remote": "1.74.0",
    "@theia/remote-wsl": "1.74.0",
    "@theia/scanoss": "1.74.0",
    "@theia/scm": "1.74.0",
    "@theia/scm-extra": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/secondary-window": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/telemetry": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/terminal-manager": "1.74.0",
    "@theia/timeline": "1.74.0",
    "@theia/typehierarchy": "1.74.0",
    "@theia/userstorage": "1.74.0",
    "@theia/variable-resolver": "1.74.0",
    "@theia/vsx-registry": "1.74.0",
    "@theia/workspace": "1.74.0"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0",
    "@types/node": "24",
    "electron": "42.3.0",
    "typescript": "~5.9.3"
  }
}
